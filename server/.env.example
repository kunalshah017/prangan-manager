# Server Configuration
PORT=3000
HOST=localhost

# Environment
NODE_ENV=development

# Add your other environment variables here
# PostgreSQL connection string
DATABASE_URL=
# JWT_SECRET=

# Signs browser image uploads (the Cloudinary upload preset stays disabled)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Private Vercel Blob store with the coursebook PDFs (books/<bookId>.pdf)
# BLOB_READ_WRITE_TOKEN=

# Local fixture-only controls. Never set these in shared or production environments.
# ALLOW_LOCAL_SEED=true
# ALLOW_DESTRUCTIVE_SEED=true
# DEV_SEED_PASSWORD=
