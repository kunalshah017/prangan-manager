# Server Configuration
PORT=3000
HOST=localhost

# Environment
NODE_ENV=development

# Add your other environment variables here
# PostgreSQL connection string
DATABASE_URL=
# JWT_SECRET=

# Signs browser image uploads (the Cloudinary upload preset stays disabled)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Private Cloudflare R2 bucket with the coursebook PDFs (books/<bookId>.pdf).
# Use a read-only R2 API token limited to that bucket.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Push notifications: generate once with `npx web-push generate-vapid-keys`.
# Without them the app still shows notifications in the bell, without push.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
